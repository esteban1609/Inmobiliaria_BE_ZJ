@model IEnumerable<Usuario>

<h1>Usuarios</h1>

<p><a asp-action="Create" class="btn btn-primary">Nuevo Usuario</a></p>

<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Email</th>
            <th>Rol</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr class="@(item.Estado ? "" : "table-secondary text-muted")">
                <td>@item.Nombre</td>
                <td>@item.Apellido</td>
                <td>@item.Email</td>
                <td><span class="badge bg-info text-dark">@item.Rol</span></td>
                <td>
                    @if (item.Estado)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactivo</span>
                    }
                </td>
                <td>
                    @if (item.Estado)
                    {
                        <a asp-action="Edit" asp-route-id="@item.IdUsuario"
                            class="btn btn-sm btn-outline-primary me-2">
                            Editar
                        </a>
                        <form asp-action="Delete" asp-route-id="@item.IdUsuario" method="post" style="display:inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Dar de baja</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Reactivar" asp-route-id="@item.IdUsuario" method="post" style="display:inline">
                            <button type="submit" class="btn btn-sm btn-outline-success">Reactivar</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
