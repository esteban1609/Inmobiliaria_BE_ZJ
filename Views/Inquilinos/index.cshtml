@model IEnumerable<Inmobiliaria_BarrosoEsteban.Models.Inquilino>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Inquilinos</h2>
            <p class="text-muted mb-0">Administración de inquilinos registrados</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Nuevo Inquilino
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Nombre</th>
                            <th>Apellido</th>
                            <th>DNI</th>
                            <th>Teléfono</th>
                            <th>Email</th>
                            <th>Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">
                                    @item.Nombre
                                </td>

                                <td>
                                    @item.Apellido
                                </td>

                                <td>
                                    @item.Dni
                                </td>

                                <td>
                                    @item.Telefono
                                </td>

                                <td>
                                    @item.Email
                                </td>

                                <td>
                                    @if (item.Estado)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactivo</span>
                                    }
                                </td>

                                <td>
                                    @if (item.Estado)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.IdInquilino"
                                            class="btn btn-sm btn-outline-primary me-2">
                                            Editar
                                        </a>

                                        <form asp-action="DarDeBaja" asp-route-id="@item.IdInquilino" method="post"
                                            style="display:inline">

                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                Dar de baja
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Reactivar" asp-route-id="@item.IdInquilino" method="post"
                                            style="display:inline">

                                            <button type="submit" class="btn btn-sm btn-outline-success">
                                                Dar de alta
                                            </button>
                                        </form>
                                    }
                                </td>


                                <td class="text-center">
                                    @*
                                    <a asp-action="Edit" asp-route-id="@item.IdInquilino"
                                        class="btn btn-sm btn-outline-primary me-2">
                                        Editar
                                    </a>

                                     
                                    <a asp-action="Delete" asp-route-id="@item.IdInquilino"
                                    class="btn btn-sm btn-outline-danger">
                                    Eliminar
                                    </a>
                                    *@
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>