@model IEnumerable<Inmobiliaria_BarrosoEsteban.Models.Inmueble>

<div class="container mt-4">

    <div class="mb-4">
        <h2 class="fw-bold">
            Inmuebles más reservados
        </h2>

        <p class="text-muted">
            Reservas realizadas durante los últimos 365 días
        </p>
    </div>

    <table class="table table-hover">

        <thead>
            <tr>
                <th>Posición</th>
                <th>Inmueble</th>
                <th>Propietario</th>
                <th>Cantidad de reservas</th>
                <th>Estado</th>
            </tr>
        </thead>

        <tbody>

            @{
                int posicion = 1;
            }

            @foreach (var item in Model)
            {
                <tr>

                    <td>
                        @posicion
                    </td>

                    <td>
                        @item.Direccion
                    </td>

                    <td>
                        @item.Propietario?.Nombre
                        @item.Propietario?.Apellido
                    </td>

                    <td>
                        <strong>
                            @item.CantidadReservas
                        </strong>
                    </td>

                    <td>
                        @if (item.Estado)
                        {
                            <span class="badge bg-success">
                                Activo
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Inactivo
                            </span>
                        }
                    </td>

                </tr>

                posicion++;
            }

        </tbody>

    </table>

    <a asp-action="Index"
       class="btn btn-outline-secondary">
        Volver a Inmuebles
    </a>

</div>