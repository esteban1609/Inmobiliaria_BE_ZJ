@model IEnumerable<Inmobiliaria_BarrosoEsteban.Models.Inmueble>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Inmuebles</h2>
            <p class="text-muted mb-0">Registre su propio Inmueble</p>
        </div>

    </div>


    <div>
        <a asp-action="Create" class="btn btn-primary">
            + Nuevo Inmueble
        </a>
    </div>


    <form asp-action="Index" method="get" class="mb-4">

        <div class="row">

            <div class="col-md-3">

                <label class="form-label">
                    Estado del inmueble
                </label>

                <select name="estado" class="form-select">

                    <option value="" selected="@(ViewBag.EstadoSeleccionado == null)">
                        Todos
                    </option>

                    <option value="true" selected="@(ViewBag.EstadoSeleccionado == true)">
                        Disponibles
                    </option>

                    <option value="false" selected="@(ViewBag.EstadoSeleccionado == false)">
                        No disponibles
                    </option>

                </select>

            </div>


            <div class="col-md-4">

                <label class="form-label">
                    Propietario
                </label>

                <select name="idPropietario" class="form-select">

                    <option value="">
                        Todos los propietarios
                    </option>

                    @foreach (var propietario in ViewBag.Propietarios)
                    {
                        <option value="@propietario.IdPropietario"
                            selected="@(ViewBag.PropietarioSeleccionado == propietario.IdPropietario)">
                            @propietario.Nombre @propietario.Apellido
                        </option>
                    }

                </select>

            </div>


            <div class="col-md-3 d-flex align-items-end">

                <button type="submit" class="btn btn-primary me-2">
                    Filtrar
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary">
                    Limpiar
                </a>

            </div>

        </div>

    </form>

    <table class="table table-hover">

        <thead>
            <tr>
                <th>Tipo de inmueble</th>
                <th>Dirección</th>
                <th>Cupo</th>
                <th>Precio por día</th>
                <th>Propietario</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>
                        @item.TipoInmueble?.Nombre
                    </td>

                    <td>
                        @item.Direccion
                    </td>

                    <td>
                        @item.Cupo
                    </td>

                    <td>
                        $ @item.PrecioPorDia
                    </td>

                    <td>
                        @item.Propietario?.Nombre
                        @item.Propietario?.Apellido
                    </td>

                    <td>
                        @if (item.Estado)
                        {
                            <span class="badge bg-success">
                                Activo
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Inactivo
                            </span>
                        }
                    </td>

                    <td>
                        <a asp-action="Details" asp-route-id="@item.IdInmueble" class="btn btn-sm btn-outline-info">
                            Detalles
                        </a>

                        @if (item.Estado)
                        {
                            <a asp-action="Edit" asp-route-id="@item.IdInmueble" class="btn btn-sm btn-outline-primary">
                                Editar
                            </a>

                            <form asp-action="Delete" asp-route-id="@item.IdInmueble" method="post" style="display:inline">

                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    Dar de baja
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="Reactivar" asp-route-id="@item.IdInmueble" method="post" style="display:inline">

                                <button type="submit" class="btn btn-sm btn-outline-success">
                                    Dar de alta
                                </button>
                            </form>
                        }

                        <a asp-action="Imagenes" asp-route-id="@item.IdInmueble" class="btn btn-sm btn-outline-secondary">
                            Imágenes
                        </a>
                    </td>

                </tr>
            }

        </tbody>

    </table>

    <div class="d-flex justify-content-center align-items-center gap-3 mt-4">

    @if (ViewBag.PaginaNro > 1)
    {
        <a asp-action="Index" asp-route-paginaNro="@(ViewBag.PaginaNro - 1)" asp-route-tamPagina="@ViewBag.TamPagina"
            class="btn btn-outline-primary">
            Anterior
        </a>
    }

    <span>
        Página @ViewBag.PaginaNro
    </span>

    @if (Model.Count() == ViewBag.TamPagina)
    {
        <a asp-action="Index" asp-route-paginaNro="@(ViewBag.PaginaNro + 1)" asp-route-tamPagina="@ViewBag.TamPagina"
            class="btn btn-outline-primary">
            Siguiente
        </a>
    }

</div>

</div>