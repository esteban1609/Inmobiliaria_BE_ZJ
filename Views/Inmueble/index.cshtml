@model IEnumerable<Inmobiliaria_BarrosoEsteban.Models.Inmueble>

<table class="table table-hover">

    <thead>
        <tr>
            <th>Dirección</th>
            <th>Cupo</th>
            <th>Precio por día</th>
            <th>Propietario</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>

    @foreach (var item in Model)
    {
        <tr>

            <td>
                @item.Direccion
            </td>

            <td>
                @item.Cupo
            </td>

            <td>
                $ @item.PrecioPorDia
            </td>

            <td>
                @item.Propietario?.Nombre
                @item.Propietario?.Apellido
            </td>

            <td>
                @if (item.Estado)
                {
                    <span class="badge bg-success">
                        Activo
                    </span>
                }
                else
                {
                    <span class="badge bg-danger">
                        Inactivo
                    </span>
                }
            </td>

            <td>

                <a asp-action="Details"
                   asp-route-id="@item.IdInmueble"
                   class="btn btn-sm btn-outline-info">
                    Detalles
                </a>

                <a asp-action="Edit"
                   asp-route-id="@item.IdInmueble"
                   class="btn btn-sm btn-outline-primary">
                    Editar
                </a>

            </td>

        </tr>
    }

    </tbody>

</table>