@model IEnumerable<Inmobiliaria_BarrosoEsteban.Models.Inmueble>

<table class="table table-hover">

    <div class="container mt-4">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-1">Inmuebles</h2>
                <p class="text-muted mb-0">Registre su propio Inmueble</p>
            </div>

            <a asp-action="Create" class="btn btn-primary">
                + Nuevo Inquilino
            </a>
        </div>


        <thead>
            <tr>
                <th>Dirección</th>
                <th>Cupo</th>
                <th>Precio por día</th>
                <th>Propietario</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>
                        @item.Direccion
                    </td>

                    <td>
                        @item.Cupo
                    </td>

                    <td>
                        $ @item.PrecioPorDia
                    </td>

                    <td>
                        @item.Propietario?.Nombre
                        @item.Propietario?.Apellido
                    </td>

                    <td>
                        @if (item.Estado)
                        {
                            <span class="badge bg-success">
                                Activo
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Inactivo
                            </span>
                        }
                    </td>

                    <td>
                        <a asp-action="Details" asp-route-id="@item.IdInmueble" class="btn btn-sm btn-outline-info">
                            Detalles
                        </a>

                        @if (item.Estado)
                        {
                            <form asp-action="Delete" asp-route-id="@item.IdInmueble" method="post" style="display:inline">

                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    Dar de baja
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="Reactivar" asp-route-id="@item.IdInmueble" method="post" style="display:inline">

                                <button type="submit" class="btn btn-sm btn-outline-success">
                                    Dar de alta
                                </button>
                            </form>
                        }
                    </td>

                </tr>
            }

        </tbody>

</table>