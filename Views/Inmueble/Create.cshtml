@model Inmobiliaria_BarrosoEsteban.Models.Inmueble

<div class="container mt-4">

    <div class="row justify-content-center">
        <div class="col-md-7">

            <div class="card shadow-sm border-0">

                <div class="card-body p-4">

                    <h3 class="fw-bold">
                        Nuevo Inmueble
                    </h3>
                    <p class="text-muted mb-4">
                        Complete los datos para registrar un nuevo Inmueble.
                    </p>

                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="id_tipo" class="form-label">
                                Tipo de Inmueble
                            </label>

                            <select id="id_tipo" name="id_tipo" class="form-select"></select>

                            <span asp-validation-for="TipoInmueble" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Direccion" class="form-label">
                            </label>

                            <input asp-for="Direccion" class="form-control" />

                            <span asp-validation-for="Direccion" class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Cupo" class="form-label">
                            </label>

                            <input asp-for="Cupo" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="PrecioPorDia" class="form-label">
                            </label>

                            <input asp-for="PrecioPorDia" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="PorcentajeReserva" class="form-label">
                            </label>

                            <input asp-for="PorcentajeReserva" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Latitud" class="form-label">
                                Latitud
                            </label>

                            <input asp-for="Latitud" class="form-control" placeholder="Ej: -33,2980000" />

                            <span asp-validation-for="Latitud" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Longitud" class="form-label">
                                Longitud
                            </label>

                            <input asp-for="Longitud" class="form-control" placeholder="Ej: -66,3400000" />

                            <span asp-validation-for="Longitud" class="text-danger"></span>
                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Propietario
                            </label>

                            <select id="IdPropietario" name="IdPropietario" class="form-select"></select>

                            <div class="d-flex justify-content-end gap-2 mt-3">

                                <a asp-action="Index" class="btn btn-outline-secondary">
                                    Volver
                                </a>

                                <button type="submit" class="btn btn-primary px-4">
                                    Guardar
                                </button>

                            </div>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(function () {
            $('#id_tipo').select2({
                theme: 'bootstrap-5',
                placeholder: 'Buscar tipo de inmueble...',
                minimumInputLength: 0,
                ajax: {
                    url: '/TipoInmueble/BuscarJson',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) { return { term: params.term || '' }; },
                    processResults: function (data) { return data; }
                }
            });

            $('#IdPropietario').select2({
                theme: 'bootstrap-5',
                placeholder: 'Buscar propietario por nombre, apellido o DNI...',
                minimumInputLength: 1,
                ajax: {
                    url: '/Propietario/BuscarJson',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) { return { term: params.term }; },
                    processResults: function (data) { return data; }
                }
            });
        });
    </script>
}
