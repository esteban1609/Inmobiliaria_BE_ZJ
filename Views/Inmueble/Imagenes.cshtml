@model Inmobiliaria_BarrosoEsteban.Models.Inmueble

@{
    ViewData["Title"] = "Inmueble - Imágenes";
    var Id = Model?.IdInmueble ?? 0;

}


<div class="container mt-4">

    <div class="mb-4">
        <h2 class="fw-bold mb-1">Fotos del Inmueble</h2>
        <p class="text-muted mb-0">@Model?.Direccion</p>
    </div>

    <div class="row g-4">

        <!-- PORTADA -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">

                    <h4 class="mb-1">Foto de Portada</h4>
                    <p class="text-muted small mb-4">
                        Imagen principal del inmueble.
                    </p>

                    @if (!string.IsNullOrEmpty(Model?.Portada))
                    {
                        <div class="mb-4">

                            <img src="@Model.Portada" class="portada-inmueble" alt="Portada del inmueble" />

                            <form asp-controller="Inmueble" asp-action="Portada" method="post" class="mt-3">

                                <input type="hidden" name="InmuebleId" value="@Id" />

                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    <i class="fas fa-trash-alt me-1"></i>
                                    Eliminar portada
                                </button>
                            </form>

                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light border">
                            No hay una foto de portada cargada.
                        </div>
                    }

                    <hr class="my-4" />

                    <form asp-controller="Inmueble" asp-action="Portada" method="post" enctype="multipart/form-data">

                        <label for="Archivo" class="form-label fw-semibold">
                            Seleccionar nueva portada
                        </label>

                        <input type="file" class="form-control mb-3" id="Archivo" name="Archivo" accept="image/*"
                            required />

                        <input type="hidden" name="InmuebleId" value="@Id" />

                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-upload me-1"></i>
                            Subir portada
                        </button>

                    </form>

                </div>
            </div>
        </div>


        <!-- IMÁGENES INTERIORES -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">

                    <h4 class="mb-1">Imágenes del Interior</h4>
                    <p class="text-muted small mb-4">
                        Galería de fotografías del inmueble.
                    </p>

                    <label class="form-label fw-semibold">
                        Imágenes actuales
                    </label>

                    <div class="d-flex flex-wrap gap-3 mb-4" id="galeriaActual">

                        @if (Model?.Imagenes?.Count > 0)
                        {
                            foreach (var imagen in Model.Imagenes)
                            {
                                <div class="imagen-con-hover">

                                    <img src="@imagen.Url" class="imagen-interior" alt="Imagen interior" />

                                    <button type="button" class="btn-eliminar-imagen" onclick="eliminarImagen(@imagen.Id)"
                                        title="Eliminar imagen">

                                        &times;

                                    </button>

                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted">
                                No hay imágenes interiores disponibles.
                            </p>
                        }

                    </div>

                    <hr class="my-4" />

                    <form id="formInterior" enctype="multipart/form-data" onsubmit="subirImagenes(event)">

                        <label for="imagenes" class="form-label fw-semibold">
                            Agregar imágenes
                        </label>

                        <input type="file" class="form-control mb-2" id="imagenes" name="imagenes"
                            onchange="previsualizar(event)" accept="image/*" multiple required />

                        <div class="form-text mb-3">
                            Podés seleccionar varias imágenes al mismo tiempo.
                        </div>

                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-upload me-1"></i>
                            Subir imágenes
                        </button>

                    </form>

                    <div class="mt-4">
                        <h6 class="fw-semibold">Previsualización</h6>

                        <div id="preview" class="d-flex flex-wrap gap-3">
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>
</div>





@section Scripts {
    <script>
        const id = @Id; // Obtener el ID del inmueble desde el modelo
        function previsualizar(event) {
            $('#preview').empty();
            const files = event.target.files;
            if (!files) return;
            //Iterar sobre los archivos seleccionados
            [...files].forEach(file => {
                const reader = new FileReader();
                reader.onload = function (e) {
                    $('#preview').append(`
                                                                                      <div class="m-2">
                                                                                       <img src="${e.target.result}" class="img-thumbnail" style="max-width: 150px; max-height: 150px;" />
                                                                                      </div>
                                                                                     `);
                };
                reader.readAsDataURL(file);
            });
        }


        // Función para subir imágenes por AJAX
        function subirImagenes(event) {
            event.preventDefault(); // Evitar el envío del formulario por defecto
            const files = document.querySelector('#imagenes').files;
            if (files.length === 0) {
                notyf.error("Selecciona al menos una imagen");
                return;
            }
            const formData = new FormData();
            for (let i = 0; i < files.length; i++) {
                formData.append('imagenes', files[i]);
            }

            $.ajax({
                url: `@Url.Action("Alta", "Imagenes", new { Id = Id })`,
                //url: `/Imagenes/Alta/${id}`,
                type: 'POST',
                data: formData,
                contentType: false,
                processData: false,
            }).done(function (imagenes) {
                notyf.success('Imágenes subidas con éxito');
                mostrarImagenes(imagenes);
            }).fail(function () {
                notyf.error('Error al subir las imágenes');
            }).always(function () {
                // Limpiar el formulario después de la subida
                document.getElementById('formInterior').reset();
                $('#preview').empty(); // Limpiar la previsualización
                $('#imagenes').val("");
            });
        }


        function eliminarImagen(imagenId) {
            $.post(`/Imagenes/Eliminar/${imagenId}`).done(function (imagenes) {
                notyf.success('Imagen eliminada');
                mostrarImagenes(imagenes);
            }).fail(function () {
                notyf.error('Error al eliminar la imagen');
            });
        }



        function mostrarImagenes(imagenes) {
            if (imagenes && imagenes.length > 0) {
                let html = ``;
                imagenes.forEach(img => {
                    html += `
                            <div class="imagen-con-hover">

                                <img src="${img.url}"
                                     class="imagen-interior"
                                     alt="Imagen interior" />

                                <button type="button"
                                        class="btn-eliminar-imagen"
                                        onclick="eliminarImagen(${img.id})"
                                        title="Eliminar imagen">

                                    &times;

                                </button>

                            </div>
                        `;
                });
                $('#galeriaActual').html(html);
            } else {
                $('#galeriaActual').html('<p>No hay imágenes interiores disponibles.</p>');
            }
        }
    </script>

    <style>
        .portada-inmueble {
            width: 100%;
            height: 420px;
            object-fit: cover;
            border-radius: 10px;
            border: 1px solid #dee2e6;
        }

        .imagen-con-hover {
            position: relative;
            width: 180px;
            height: 140px;
            overflow: hidden;
            border-radius: 10px;
            border: 1px solid #dee2e6;
            background-color: #f8f9fa;
        }

        .imagen-interior {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform 0.2s ease, opacity 0.2s ease;
        }

        .imagen-con-hover:hover .imagen-interior {
            transform: scale(1.04);
            opacity: 0.85;
        }

        .btn-eliminar-imagen {
            position: absolute;
            top: 5px;
            right: 8px;

            background: transparent;
            border: none;
            padding: 0;

            color: #dc3545;
            font-size: 30px;
            font-weight: bold;
            line-height: 1;

            cursor: pointer;
            display: none;
            z-index: 10;
        }

        .imagen-con-hover:hover .btn-eliminar-imagen {
            display: block;
        }

        .btn-eliminar-imagen:hover {
            color: #a71d2a;
            transform: scale(1.15);
        }
    </style>
}