@model Inmobiliaria_BarrosoEsteban.Models.Inmueble

<div class="container mt-4">

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">

                    <h3 class="fw-bold mb-1">Editar Inmueble</h3>
                    <p class="text-muted mb-4">
                        Modifique los datos del inmueble.
                    </p>

                    <form asp-action="Edit" method="post">

                        <input type="hidden" asp-for="IdInmueble" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Direccion"
                                   class="form-label fw-semibold">
                                Dirección
                            </label>

                            <input asp-for="Direccion"
                                   class="form-control" />

                            <span asp-validation-for="Direccion"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Cupo"
                                   class="form-label fw-semibold">
                                Cupo
                            </label>

                            <input asp-for="Cupo"
                                   class="form-control" />

                            <span asp-validation-for="Cupo"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PrecioPorDia"
                                   class="form-label fw-semibold">
                                Precio por día
                            </label>

                            <input asp-for="PrecioPorDia"
                                   class="form-control" />

                            <span asp-validation-for="PrecioPorDia"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PorcentajeReserva"
                                   class="form-label fw-semibold">
                                Porcentaje de reserva
                            </label>

                            <input asp-for="PorcentajeReserva"
                                   class="form-control" />

                            <span asp-validation-for="PorcentajeReserva"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Latitud"
                                   class="form-label fw-semibold">
                                Latitud
                            </label>

                            <input asp-for="Latitud"
                                   class="form-control" />

                            <span asp-validation-for="Latitud"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Longitud"
                                   class="form-label fw-semibold">
                                Longitud
                            </label>

                            <input asp-for="Longitud"
                                   class="form-control" />

                            <span asp-validation-for="Longitud"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="IdPropietario"
                                   class="form-label fw-semibold">
                                Propietario
                            </label>

                            <select asp-for="IdPropietario"
                                    class="form-select">

                                @foreach (var propietario in ViewBag.Propietarios)
                                {
                                    <option value="@propietario.IdPropietario">
                                        @propietario.Nombre @propietario.Apellido
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="IdPropietario"
                                  class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Volver
                            </a>

                            <button type="submit"
                                    class="btn btn-primary px-4">
                                Guardar cambios
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}