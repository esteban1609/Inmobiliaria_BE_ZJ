@model Inmobiliaria_BarrosoEsteban.Models.Reserva

@{
    ViewData["Title"] = "Renovar Reserva";
}

<h2>Renovar Reserva</h2>

<p class="text-muted">
    Se generará una nueva reserva sin modificar la reserva original.
</p>

<hr />

<form asp-action="Renovar" method="post">

    <input type="hidden" asp-for="IdInquilino" />

    <input type="hidden" asp-for="IdInmueble" />

    <div class="mb-3">
        <label class="form-label">Inquilino</label>

        <input type="text" class="form-control" value="@ViewBag.Inquilino?.Nombre @ViewBag.Inquilino?.Apellido"
            readonly />
    </div>

    <div class="mb-3">
        <label class="form-label">Inmueble</label>

        <input type="text" class="form-control" value="@ViewBag.Inmueble?.Direccion" readonly />
    </div>

    <div class="mb-3">
        <label asp-for="FechaDesde" class="form-label">
            Nueva fecha desde
        </label>

        <input asp-for="FechaDesde" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="FechaHasta" class="form-label">
            Nueva fecha hasta
        </label>

        <input asp-for="FechaHasta" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="MontoDia" class="form-label">
            Nuevo monto por día
        </label>

        <input asp-for="MontoDia" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">
        Confirmar renovación
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancelar
    </a>

</form>