@model IEnumerable<Reserva>

<h1>Reservas</h1>

<p><a asp-action="Create" class="btn btn-primary">Nueva Reserva</a></p>
<a asp-action="Vigentes" class="btn btn-outline-success mb-3">
    Reservas vigentes
</a>

<a asp-action="ProximasAFinalizar" class="btn btn-outline-warning mb-3">
    Próximas a finalizar
</a>

<a asp-action="Disponibles" class="btn btn-outline-primary mb-3">
    Consultar disponibilidad
</a>

<a asp-action="SinReservas" class="btn btn-outline-warning mb-3">
    Sin reservas
</a>

<a asp-action="MasReservados" class="btn btn-outline-primary mb-3">
    Más reservados
</a>
<table class="table">
    <thead>
        <tr>
            <th>Inquilino</th>
            <th>Inmueble</th>
            <th>Monto/día</th>
            <th>Desde</th>
            <th>Hasta</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr class="@(item.Estado ? "" : "table-secondary text-muted")">
                <td>@item.NombreInquilino</td>
                <td>@item.DireccionInmueble</td>
                <td>@item.MontoDia.ToString("C")</td>
                <td>@item.FechaDesde.ToShortDateString()</td>
                <td>@item.FechaHasta.ToShortDateString()</td>
                <td>
                    @if (item.Estado)
                    {
                        <span class="badge bg-success">Activa</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactiva</span>
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.IdReserva" class="btn btn-sm btn-outline-secondary me-2">
                        Ver
                    </a>
                    @if (item.Estado)
                    {
                        <a asp-action="Edit" asp-route-id="@item.IdReserva" class="btn btn-sm btn-outline-primary me-2">
                            Editar
                        </a>
                        <form asp-action="Delete" asp-route-id="@item.IdReserva" method="post" style="display:inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Dar de Baja</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Reactivar" asp-route-id="@item.IdReserva" method="post" style="display:inline">
                            <button type="submit" class="btn btn-sm btn-outline-success">Reactivar</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>


<div class="d-flex justify-content-center align-items-center gap-3 mt-4">

    @if (ViewBag.PaginaNro > 1)
    {
        <a asp-action="Index" asp-route-paginaNro="@(ViewBag.PaginaNro - 1)" asp-route-tamPagina="@ViewBag.TamPagina"
            class="btn btn-outline-primary">
            Anterior
        </a>
    }

    <span>
        Página @ViewBag.PaginaNro
    </span>

    @if (Model.Count() == ViewBag.TamPagina)
    {
        <a asp-action="Index" asp-route-paginaNro="@(ViewBag.PaginaNro + 1)" asp-route-tamPagina="@ViewBag.TamPagina"
            class="btn btn-outline-primary">
            Siguiente
        </a>
    }

</div>