@model IEnumerable<Inmobiliaria_BarrosoEsteban.Models.Inmueble>

<div class="container mt-4">

    <div class="mb-4">

        <h2 class="fw-bold">
            Inmuebles sin reservas
        </h2>

        <p class="text-muted">
            Inmuebles que no tuvieron reservas
            durante los últimos @ViewBag.Dias días.
        </p>

    </div>


    <form asp-action="SinReservas"
          method="get"
          class="mb-4">

        <div class="row">

            <div class="col-md-3">

                <label class="form-label">
                    Cantidad de días
                </label>

                <input type="number"
                       name="dias"
                       value="@ViewBag.Dias"
                       min="1"
                       class="form-control" />

            </div>

            <div class="col-md-3 d-flex align-items-end">

                <button type="submit"
                        class="btn btn-primary">
                    Consultar
                </button>

            </div>

        </div>

    </form>


    <table class="table table-hover">

        <thead>

            <tr>
                <th>Tipo</th>
                <th>Dirección</th>
                <th>Propietario</th>
                <th>Estado</th>
            </tr>

        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>
                        @item.TipoInmueble?.Nombre
                    </td>

                    <td>
                        @item.Direccion
                    </td>

                    <td>
                        @item.Propietario?.Nombre
                        @item.Propietario?.Apellido
                    </td>

                    <td>

                        @if (item.Estado)
                        {
                            <span class="badge bg-success">
                                Activo
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Inactivo
                            </span>
                        }

                    </td>

                </tr>
            }

        </tbody>

    </table>


    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No se encontraron inmuebles sin reservas
            durante los últimos @ViewBag.Dias días.
        </div>
    }


    <a asp-action="Index"
       class="btn btn-outline-secondary">
        Volver a Inmuebles
    </a>

</div>