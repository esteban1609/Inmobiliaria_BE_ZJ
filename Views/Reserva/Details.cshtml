@model Reserva

<h1>Detalle de Reserva</h1>

<dl class="row">
    <dt class="col-sm-3">Inquilino</dt>
    <dd class="col-sm-9">@Model.NombreInquilino</dd>
    <dt class="col-sm-3">Inmueble</dt>
    <dd class="col-sm-9">@Model.DireccionInmueble</dd>
    <dt class="col-sm-3">Monto por día</dt>
    <dd class="col-sm-9">@Model.MontoDia.ToString("C")</dd>
    <dt class="col-sm-3">Desde</dt>
    <dd class="col-sm-9">@Model.FechaDesde.ToShortDateString()</dd>
    <dt class="col-sm-3">Hasta</dt>
    <dd class="col-sm-9">@Model.FechaHasta.ToShortDateString()</dd>
    <dt class="col-sm-3">Estado</dt>
    <dd class="col-sm-9">@(Model.Estado ? "Activa" : "Inactiva")</dd>
</dl>

@if (User.IsInRole("Administrador"))
{
    <div class="card mb-3">
        <div class="card-header">Auditoría</div>
        <div class="card-body">
            <p><strong>Creada por:</strong> @(Model.NombreUsuarioCreador ?? "-")</p>
            <p><strong>Terminada por:</strong> @(Model.NombreUsuarioTerminador ?? "-- (sigue activa) --")</p>
        </div>
    </div>
}

<h3>Pagos</h3>

<p><a asp-controller="Pago" asp-action="Create" asp-route-idReserva="@Model.IdReserva">Cargar pago</a></p>

<table class="table">
    <thead>
        <tr>
            <th>Concepto</th>
            <th>Fecha</th>
            <th>Importe</th>
            <th>Estado</th>
            @if (User.IsInRole("Administrador"))
            {
                <th>Creado por</th>
                <th>Anulado por</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var pago in (IEnumerable<Pago>)ViewBag.Pagos)
        {
            <tr class="@(pago.Estado ? "" : "table-secondary text-muted")">
                <td>@pago.Concepto</td>
                <td>@pago.FechaPago.ToShortDateString()</td>
                <td>@pago.Importe.ToString("C")</td>
                <td>@(pago.Estado ? "Activo" : "Anulado")</td>
                @if (User.IsInRole("Administrador"))
                {
                    <td>@(pago.NombreUsuarioCreador ?? "-")</td>
                    <td>@(pago.NombreUsuarioAnulador ?? "-")</td>
                }
            </tr>
        }
    </tbody>
</table>

<p>
    <a asp-controller="Pago" asp-action="Index" asp-route-idReserva="@Model.IdReserva">Ver todos los pagos</a> | 
    <a asp-action="Terminar" asp-route-id="@Model.IdReserva">Terminar reserva</a>
</p>

<a asp-action="Index">Volver al listado de reservas</a>