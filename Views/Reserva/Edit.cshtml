@model Reserva

<h1>Editar Reserva</h1>

<form asp-action="Edit" asp-route-id="@Model.IdReserva" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="IdInquilino"></label>
        <select id="IdInquilino" name="IdInquilino" class="form-control">
            <option value="@Model.IdInquilino" selected>@Model.NombreInquilino</option>
        </select>
        <span asp-validation-for="IdInquilino" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="IdInmueble"></label>
        <select id="IdInmueble" name="IdInmueble" class="form-control">
            <option value="@Model.IdInmueble" selected>@Model.DireccionInmueble</option>
        </select>
        <span asp-validation-for="IdInmueble" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MontoDia"></label>
        <input asp-for="MontoDia" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="MontoDia" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="FechaDesde"></label>
        <input asp-for="FechaDesde" class="form-control" type="date" />
        <span asp-validation-for="FechaDesde" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="FechaHasta"></label>
        <input asp-for="FechaHasta" class="form-control" type="date" />
        <span asp-validation-for="FechaHasta" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(function () {
            $('#IdInquilino').select2({
                theme: 'bootstrap-5',
                placeholder: 'Buscar inquilino por nombre, apellido o DNI...',
                minimumInputLength: 1,
                ajax: {
                    url: '/Inquilinos/BuscarJson',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) { return { term: params.term }; },
                    processResults: function (data) { return data; }
                }
            });

            $('#IdInmueble').select2({
                theme: 'bootstrap-5',
                placeholder: 'Buscar inmueble por dirección...',
                minimumInputLength: 1,
                ajax: {
                    url: '/Inmueble/BuscarJson',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) { return { term: params.term }; },
                    processResults: function (data) { return data; }
                }
            });
        });
    </script>
}

