@model IEnumerable<Propietario>

<h1>Propietarios</h1>

<p><a asp-action="Create" class="btn btn-primary">Nuevo Propietario</a></p>

<table class="table">
    <thead>
        <tr>
            <th>DNI</th>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Teléfono</th>
            <th>Email</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr class="@(item.Estado ? "" : "table-secondary text-muted")">
                <td>@item.Dni</td>
                <td>@item.Nombre</td>
                <td>@item.Apellido</td>
                <td>@item.Telefono</td>
                <td>@item.Email</td>
                <td>
                    @if (item.Estado)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactivo</span>
                    }
                </td>
                <td>
                    @if (item.Estado)
                    {
                        <a asp-action="Edit" asp-route-id="@item.IdPropietario"
                            class="btn btn-sm btn-outline-primary me-2">
                            Editar
                        </a>
                        <form asp-action="Delete" asp-route-id="@item.IdPropietario" method="post" style="display:inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Dar de baja</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Reactivar" asp-route-id="@item.IdPropietario" method="post" style="display:inline">
                            <button type="submit" class="btn btn-sm btn-outline-success">Reactivar</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>


<div class="d-flex justify-content-center align-items-center gap-3 mt-4">

    @if (ViewBag.PaginaNro > 1)
    {
        <a asp-action="Index" asp-route-paginaNro="@(ViewBag.PaginaNro - 1)" asp-route-tamPagina="@ViewBag.TamPagina"
            class="btn btn-outline-primary">
            Anterior
        </a>
    }

    <span>
        Página @ViewBag.PaginaNro
    </span>

    @if (Model.Count() == ViewBag.TamPagina)
    {
        <a asp-action="Index" asp-route-paginaNro="@(ViewBag.PaginaNro + 1)" asp-route-tamPagina="@ViewBag.TamPagina"
            class="btn btn-outline-primary">
            Siguiente
        </a>
    }

</div>
