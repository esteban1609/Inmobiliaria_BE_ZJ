@model TipoInmueble

<div class="container mt-4">

    <h2 class="fw-bold">Editar Tipo de Inmueble</h2>

    <p class="text-muted">
        Modifique los datos del tipo de inmueble.
    </p>

    <form asp-action="Edit" asp-route-id="@Model.id_tipo" method="post">

        <input type="hidden" asp-for="id_tipo" />

        <div asp-validation-summary="All" class="text-danger mb-3">
        </div>

        <div class="mb-3">

            <label asp-for="Nombre" class="form-label">
                Nombre
            </label>

            <input asp-for="Nombre" class="form-control" />

            <span asp-validation-for="Nombre" class="text-danger">
            </span>

        </div>

        <div class="mt-4">

            <a asp-action="Index" class="btn btn-outline-secondary">
                Volver
            </a>

            <button type="submit" class="btn btn-primary">
                Guardar cambios
            </button>

        </div>
    </form>

</div>