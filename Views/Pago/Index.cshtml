@model IEnumerable<Pago>

<h1>Pagos de la Reserva #@ViewBag.IdReserva</h1>

<p><a asp-action="Create" asp-route-idReserva="@ViewBag.IdReserva" class= "btn btn-primary">Cargar nuevo pago</a></p>

<table class="table">
    <thead>
        <tr>
            <th>Concepto</th>
            <th>Fecha</th>
            <th>Importe</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr class="@(item.Estado ? "" : "table-secondary text-muted")">
                <td>@item.Concepto</td>
                <td>@item.FechaPago.ToShortDateString()</td>
                <td>@item.Importe.ToString("C")</td>
                <td>
                    @if (item.Estado)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Anulado</span>
                    }
                </td>
                <td>
                    @if (item.Estado)
                    {
                        <a asp-action="Edit" asp-route-id="@item.IdPago" class= "btn btn-primary">Editar concepto</a> 
                        <a asp-action="Anular" asp-route-id="@item.IdPago" class= "btn btn-primary">Anular</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-controller="Reserva" asp-action="Details" asp-route-id="@ViewBag.IdReserva" class= "btn btn-primary">Volver a la reserva</a>


<div class="d-flex justify-content-center align-items-center gap-3 mt-4">

    @if (ViewBag.PaginaNro > 1)
    {
        <a asp-action="Index" asp-route-paginaNro="@(ViewBag.PaginaNro - 1)" asp-route-tamPagina="@ViewBag.TamPagina"
            class="btn btn-outline-primary">
            Anterior
        </a>
    }

    <span>
        Página @ViewBag.PaginaNro
    </span>

    @if (Model.Count() == ViewBag.TamPagina)
    {
        <a asp-action="Index" asp-route-paginaNro="@(ViewBag.PaginaNro + 1)" asp-route-tamPagina="@ViewBag.TamPagina"
            class="btn btn-outline-primary">
            Siguiente
        </a>
    }

</div>