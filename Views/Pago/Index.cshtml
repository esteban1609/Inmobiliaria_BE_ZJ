@model IEnumerable<Pago>

<h1>Pagos de la Reserva #@ViewBag.IdReserva</h1>

<p><a asp-action="Create" asp-route-idReserva="@ViewBag.IdReserva">Cargar nuevo pago</a></p>

<table class="table">
    <thead>
        <tr>
            <th>Concepto</th>
            <th>Fecha</th>
            <th>Importe</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr class="@(item.Estado ? "" : "table-secondary text-muted")">
                <td>@item.Concepto</td>
                <td>@item.FechaPago.ToShortDateString()</td>
                <td>@item.Importe.ToString("C")</td>
                <td>
                    @if (item.Estado)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Anulado</span>
                    }
                </td>
                <td>
                    @if (item.Estado)
                    {
                        <a asp-action="Edit" asp-route-id="@item.IdPago">Editar concepto</a> 
                        <a asp-action="Anular" asp-route-id="@item.IdPago">Anular</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-controller="Reserva" asp-action="Details" asp-route-id="@ViewBag.IdReserva">Volver a la reserva</a>
